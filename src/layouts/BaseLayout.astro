---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title: string;
	description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title === site.name ? site.fullName : `${title} — ${site.fullName}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0d0d0d" />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="site-shell">
			<div class="terminal-window">
				<slot name="header" />
				<main class="terminal__body">
					<slot />
				</main>
				<slot name="footer" />
			</div>
		</div>
	</body>
</html>
