---
import { site } from '../data/site';

interface Props {
	path?: string;
	command?: string;
}

const { path = '~', command } = Astro.props;
const { user, host } = site.shell;
---

<p class="prompt">
	<span class="prompt__user">{user}@{host}</span>:<span class="prompt__path">{path}</span>${' '}{
		command && <span class="prompt__cmd">{command}</span>
	}
</p>
