---
import { site } from '../data/site';
---

<script is:inline>
	(function () {
		try {
			var seen = sessionStorage.getItem('cheuyin-phosphor-seen') === '1';
			var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!seen && !reduced) {
				document.documentElement.classList.add('phosphor-animate');
			}
		} catch (e) {
			/* private browsing */
		}
	})();
</script>

<section class="section hero hero--phosphor" id="hero-phosphor">
	<div class="hero__crt" id="hero-crt" aria-hidden="true">
		<div class="hero__dim"></div>
		<div class="hero__scanline"></div>
	</div>

	<div class="hero__content">
		<h1 class="hero__name">{site.fullName}</h1>
		<p class="hero__role">{site.role}</p>
		<p class="hero__tagline">{site.tagline}</p>
	</div>
</section>

<script>
	const STORAGE_KEY = 'cheuyin-phosphor-seen';
	const TOTAL_MS = 1600;

	const root = document.getElementById('hero-phosphor');
	const crt = document.getElementById('hero-crt');

	if (root) {
		const prefersReducedMotion = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches;

		let seen = false;
		try {
			seen = sessionStorage.getItem(STORAGE_KEY) === '1';
		} catch {
			/* private browsing */
		}

		if (prefersReducedMotion || seen) {
			finish();
		} else {
			start();
		}
	}

	function finish() {
		root?.classList.remove('is-animating');
		root?.classList.add('is-ready');
		document.documentElement.classList.remove('phosphor-animate');
		crt?.remove();
		document.removeEventListener('keydown', onSkip);
		root?.removeEventListener('click', onSkip);

		try {
			sessionStorage.setItem(STORAGE_KEY, '1');
		} catch {
			/* private browsing */
		}
	}

	function onSkip() {
		finish();
	}

	function start() {
		root?.classList.add('is-animating');
		document.addEventListener('keydown', onSkip, { once: true });
		root?.addEventListener('click', onSkip, { once: true });
		window.setTimeout(finish, TOTAL_MS);
	}
</script>
