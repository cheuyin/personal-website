<div class="desk-still" data-desk-still>
	<canvas
		class="desk-still-canvas"
		tabindex="0"
		role="img"
		aria-label="A small 3D still life of a silvery metallic laptop with a matching silver apple logo, a potted plant, a ceramic cup of black coffee, and a ballpoint pen on paper, all sitting on a wooden table. Drag or use the arrow keys to turn it."
	></canvas>
</div>

<script>
	import { mountDeskStill } from '../lib/desk-scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-desk-still]')) {
		const canvas = root.querySelector('canvas');

		if (canvas) {
			mountDeskStill(canvas);
		}
	}
</script>
