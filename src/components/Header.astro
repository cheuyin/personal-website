---
import { site } from '../data/site';

type NavPath = '/' | '/writing' | '/work';

interface Props {
	currentPath: NavPath;
	pageLabel?: string;
}

const { currentPath, pageLabel } = Astro.props;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/writing', label: 'Writing' },
	{ href: '/work', label: 'Work' },
] as const satisfies ReadonlyArray<{ href: NavPath; label: string }>;

const shellPrompt = `${site.shell.user}@${site.shell.host}`;

const pathLabels: Record<NavPath, string> = {
	'/': 'home',
	'/writing': 'writing',
	'/work': 'work',
};

const titleLabel = pageLabel ?? pathLabels[currentPath];
---

<header>
	<div class="terminal__titlebar">
		<div class="terminal__controls" aria-hidden="true">
			<span class="terminal__dot terminal__dot--red"></span>
			<span class="terminal__dot terminal__dot--amber"></span>
			<span class="terminal__dot terminal__dot--green"></span>
		</div>
		<span class="terminal__title">{shellPrompt} — {titleLabel}</span>
	</div>
	<nav class="terminal__nav" aria-label="Primary">
		{
			links.map(({ href, label }) => (
				<a href={href} aria-current={currentPath === href ? 'page' : undefined}>
					{label}
				</a>
			))
		}
	</nav>
</header>
