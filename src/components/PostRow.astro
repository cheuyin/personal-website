---
import type { Post } from '../data/site';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<a class="post-entry" href={`/writing/${post.slug}`}>
	<div class="post-entry__head">
		<h3 class="post-entry__title">{post.title}</h3>
		<time class="post-entry__date" datetime={post.date}>{post.date}</time>
	</div>
	<p class="post-entry__summary">{post.summary}</p>
	{
		post.tags.length > 0 && (
			<div class="post-entry__tags">
				{post.tags.map((tag) => (
					<span class="tag">{tag}</span>
				))}
			</div>
		)
	}
</a>
