---
import { site } from '../data/site';

interface Props {
	path?: string;
}

const { path = '~' } = Astro.props;
const { user, host } = site.shell;
---

<footer class="terminal__footer">
	<p class="prompt">
		<span class="prompt__user">{user}@{host}</span>:<span class="prompt__path">{path}</span>$ <span
			class="cursor">█</span>
	</p>
</footer>
