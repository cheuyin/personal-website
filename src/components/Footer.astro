---
import ContactIcon from './ContactIcon.astro';
import { contactLinks, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-rule py-6 text-[0.9375rem] text-muted">
	<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
		<p class="m-0">© {year} {site.name}</p>
		<ul class="m-0 flex list-none items-center gap-x-4 p-0">
			{
				contactLinks.map(({ label, href }) => {
					const external = !href.startsWith('mailto:');

					return (
						<li>
							<a
								class="contact-link"
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noreferrer' : undefined}
								aria-label={label}
								title={label}
							>
								<ContactIcon name={label} />
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</footer>
