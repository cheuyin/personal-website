---
import ContactIcon from './ContactIcon.astro';
import { projects } from '../data/site';
---

<div>
	{
		projects.map((project) => (
			<article class="row">
				<h2 class="m-0 text-[1.25rem] font-semibold leading-snug tracking-[-0.02em]">
					<a class="link" href={project.href} target="_blank" rel="noreferrer">
						{project.title}
					</a>
					<a
						class="contact-link ml-2 align-middle"
						href={project.href}
						target="_blank"
						rel="noreferrer"
						aria-label={`${project.title} on GitHub`}
						title="GitHub"
					>
						<ContactIcon name="GitHub" />
					</a>
				</h2>
				<p class="mt-2 m-0 text-[1.05rem] leading-7 text-muted">{project.summary}</p>
			</article>
		))
	}
</div>
