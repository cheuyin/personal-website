---
import { projects } from '../data/site';
---

<div>
	{
		projects.map((project) => (
			<article class="row">
				<h2 class="m-0 text-[1.25rem] font-semibold leading-snug tracking-[-0.02em]">
					<a class="link" href={project.href} target="_blank" rel="noreferrer">
						{project.title}
					</a>
				</h2>
				<p class="mt-2 m-0 text-[1.05rem] leading-7 text-muted">{project.summary}</p>
				<p class="mt-3 m-0">
					<a class="text-[0.9375rem] text-muted no-underline hover:text-accent hover:underline hover:underline-offset-[0.18em]" href={project.href} target="_blank" rel="noreferrer">
						GitHub
					</a>
				</p>
			</article>
		))
	}
</div>
