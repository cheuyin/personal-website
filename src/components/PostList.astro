---
import { formatDate } from '../data/site';
import { countWords, formatWordCount, type WritingPost } from '../lib/writing';

interface Props {
	posts: WritingPost[];
	heading?: 'h2' | 'h3';
}

const { posts, heading: Heading = 'h2' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="m-0 text-muted">No posts yet.</p>
	) : (
		<div>
			{posts.map((post) => (
				<article class="row">
					<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
						<Heading class="m-0 text-[1.25rem] font-semibold leading-snug tracking-[-0.02em]">
							<a class="link" href={`/writing/${post.id}`}>
								{post.data.title}
							</a>
						</Heading>
						<p class="m-0 shrink-0 text-[0.9375rem] text-muted">
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							<span> · {formatWordCount(countWords(post.body ?? ''))}</span>
						</p>
					</div>
					<p class="mt-2 m-0 text-[1.05rem] leading-7 text-muted">{post.data.summary}</p>
				</article>
			))}
		</div>
	)
}
