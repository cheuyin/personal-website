---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('writing');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
---

<SiteLayout title={post.data.title} description={post.data.summary} page="writing">
	<article class="post">
		<header class="post__header">
			<p class="post__back">
				<a class="text-link" href="/writing">← Writing</a>
			</p>
			<h1 class="post__title">{post.data.title}</h1>
			<dl class="post__meta">
				<div class="post__field">
					<dt>Date</dt>
					<dd>
						<time datetime={date}>{date}</time>
					</dd>
				</div>
				{
					post.data.tags.length > 0 && (
						<div class="post__field">
							<dt>Tags</dt>
							<dd>
								{post.data.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</dd>
						</div>
					)
				}
			</dl>
			<p class="post__summary">{post.data.summary}</p>
		</header>

		<div class="post-body">
			<Content />
		</div>
	</article>
</SiteLayout>
