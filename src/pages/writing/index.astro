---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { site, getWritingPosts } from '../../data/site';

const posts = await getWritingPosts();
---

<SiteLayout title="Writing" description={site.writingBlurb} page="writing">
	<section class="section hero hero--compact">
		<h1 class="hero__name">Writing</h1>
		<p class="hero__tagline">{site.writingBlurb}</p>
	</section>

	<section class="section">
		<h2 class="section__title">Posts</h2>
		{
			posts.length > 0 ? (
				<div class="post-list">
					{posts.map((post) => (
						<PostRow post={post} />
					))}
				</div>
			) : (
				<p class="section__text section__text--muted">No posts yet.</p>
			)
		}
	</section>
</SiteLayout>
