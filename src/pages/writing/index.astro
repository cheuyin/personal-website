---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostRow from '../../components/PostRow.astro';
import { getWritingPosts } from '../../data/site';

const posts = await getWritingPosts();
---

<BaseLayout
	title="Writing"
	description="Notes on projects, debugging, and things I'm still figuring out."
>
	<Header slot="header" currentPath="/writing" />

	<section class="section hero hero--compact">
		<h1 class="hero__name">Writing</h1>
		<p class="hero__tagline">
			Notes on projects, debugging, and things I'm still figuring out.
		</p>
	</section>

	<section class="section">
		<h2 class="section__title">Posts</h2>
		<div class="post-list">
			{posts.map((post) => <PostRow post={post} />)}
		</div>
	</section>

	<Footer slot="footer" />
</BaseLayout>
