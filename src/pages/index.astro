---
import SiteLayout from '../layouts/SiteLayout.astro';
import FocusHero from '../components/FocusHero.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import ContactList from '../components/ContactList.astro';
import { site, experience, projects, getWritingPosts } from '../data/site';

const posts = await getWritingPosts();
const latestPosts = posts.slice(0, site.homePreviewCount);
const featuredProjects = projects.slice(0, site.homePreviewCount);
---

<SiteLayout title={site.name} description={site.tagline} page="home">
	<FocusHero />

	<section class="section" id="work">
		<h2 class="section__title">Work</h2>
		<div class="experience-list">
			{experience.map((entry) => <ExperienceCard experience={entry} />)}
		</div>
		<div class="project-list project-list--follow">
			{featuredProjects.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<section class="section" id="writing">
		<h2 class="section__title">Writing</h2>
		{
			latestPosts.length > 0 ? (
				<>
					<div class="post-list">
						{latestPosts.map((post) => (
							<PostRow post={post} />
						))}
					</div>
					<p class="section__more">
						<a class="text-link" href="/writing">All writing →</a>
					</p>
				</>
			) : (
				<p class="section__text section__text--muted">No posts yet.</p>
			)
		}
	</section>

	<section class="section" id="contact">
		<h2 class="section__title">Contact</h2>
		<ContactList />
	</section>
</SiteLayout>
