---
import Base from '../layouts/Base.astro';
import NameFlip from '../components/NameFlip.astro';
import { intro, site } from '../data/site';
---

<Base description={site.description}>
	<h1 class="m-0 text-[clamp(1.7rem,calc(0.85rem+4.6vw),2.75rem)] font-semibold leading-[1.15] tracking-[-0.02em]">
		<NameFlip />
	</h1>
	<p class="mt-4 m-0 text-[0.9375rem] text-muted">{site.role}</p>
	{
		intro.map((paragraph) => (
			<p class="mt-6 m-0">
				{paragraph.map((segment) =>
					segment.href ? (
						<a class="link" href={segment.href} target="_blank" rel="noreferrer">
							{segment.text}
						</a>
					) : (
						segment.text
					),
				)}
			</p>
		))
	}
</Base>
