---
/**
 * Legacy /work route — portfolio work now lives on the homepage.
 * Keep a client redirect so old links land on #work.
 */
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content="0;url=/#work" />
		<link rel="canonical" href="/#work" />
		<title>Redirecting…</title>
		<script is:inline>
			location.replace('/#work');
		</script>
	</head>
	<body>
		<p><a href="/#work">Continue to work</a></p>
	</body>
</html>
