---
import Base from '../layouts/Base.astro';
import { dayNumber, getGroundsMonths } from '../data/grounds';

const months = getGroundsMonths();
---

<Base
	title="Discomfort Log"
	description="The cave you fear to enter holds the treasure you seek."
	noindex
>
	<h1 class="m-0 text-[2.5rem] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[2.75rem]">
		Discomfort Log
	</h1>
	<blockquote class="mt-6 m-0">
		<p class="m-0">“The cave you fear to enter holds the treasure you seek.”</p>
		<footer class="mt-2 text-[0.9375rem] text-muted">— Joseph Campbell</footer>
	</blockquote>
	{
		months.length === 0 ? (
			<p class="mt-12 m-0 text-muted">No entries yet.</p>
		) : (
			<div class="mt-12">
				{months.map((month) => (
					<section class="mb-10 last:mb-0">
						<h2 class="sticky top-[3.65rem] z-[1] m-0 border-b border-rule bg-paper py-2 text-[1.05rem] font-semibold tracking-[-0.02em]">
							{month.label}
						</h2>
						<div class="mt-3">
							{month.days.map((day) => (
								<article class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 py-2.5">
									<h3 class="m-0 pt-0.5 text-right text-[0.9375rem] font-normal leading-6 text-muted">
										<time class="tabular-nums" datetime={day.date}>
											{dayNumber(day.date)}
										</time>
									</h3>
									<ul class="m-0 list-disc space-y-1 pl-5 text-[1.05rem] leading-7 marker:text-accent">
										{day.notes.map((note) => (
											<li>{note}</li>
										))}
									</ul>
								</article>
							))}
						</div>
					</section>
				))}
			</div>
		)
	}
</Base>
